# Public site URL used for canonical links, Open Graph, and the sitemap.
# The live domain is https://amathongo.com. Set this only to override it.
NEXT_PUBLIC_SITE_URL=https://amathongo.com

# Contact details are confirmed in the site code.
# Leave the fields below blank unless you need to override them.
# The previous website published +254718532961 and the name "Dr. Makonde Nzula".
# That number uses the Kenya country code. Do not publish it.
# Do not add qualifications, awards, or an address that have not been verified.
#
# NEXT_PUBLIC_PHONE_DISPLAY is what visitors read. Confirmed: +256 791 462554.
# NEXT_PUBLIC_PHONE_TEL is the dialable form. Confirmed: +256791462554.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_TEL=
# WhatsApp uses the same number. Display: +256 791 462554. Digits: 256791462554.
NEXT_PUBLIC_WHATSAPP_DISPLAY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Confirmed: info@amathongo.com
NEXT_PUBLIC_EMAIL=
# Public location is Busabala Close, Kampala. Set these only to override it.
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_CITY=
# Confirmed: 24 hours
NEXT_PUBLIC_HOURS=

# Optional Google Maps embed URL. Leave blank to use the Busabala Close listing.
# If set, it must be an https Google Maps embed link.
NEXT_PUBLIC_MAPS_EMBED_URL=

# Analytics. Leave blank to disable. IDs are checked before any script is added.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery. Server-only. Never prefix these with NEXT_PUBLIC_.
# Set CONTACT_TO_EMAIL and either RESEND_API_KEY + CONTACT_FROM_EMAIL, or CONTACT_WEBHOOK_URL.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=
